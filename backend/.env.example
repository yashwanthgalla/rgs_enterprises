# ==============================================================================
# RGS ENTERPRISES - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment ('development' | 'production')
DJANGO_ENV=development
DEBUG=True
DJANGO_SECRET_KEY=generate-a-strong-random-50-character-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Database (Supabase PostgreSQL - AWS Sydney Region)
# Example Session Pooler (port 5432) or Transaction Pooler (port 6543):
# postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.example:password@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?sslmode=require
DB_ENGINE=postgres

# Cryptography & Security
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=Vv1b37ZJqgQ7K5f09e2O5-N7N8q2jR6_lU0Z2p8n4W8=
JWT_SECRET=super-secret-jwt-signing-key-replace-in-production
JWT_EXPIRATION_HOURS=24

# Brevo (Sendinblue) Transactional Email Service
BREVO_API_KEY=xkeysib-your-v3-api-key-here
BREVO_SENDER_EMAIL=rgsenterprise2026@gmail.com
BREVO_SENDER_NAME=RGS Enterprises
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=c106ae001@smtp-brevo.com
BREVO_SMTP_KEY=your-brevo-smtp-master-password-here

# Supabase Storage Bucket (Documents & Scans)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_STORAGE_BUCKET=hub-documents

# CORS Allowed Origins (Comma-separated for production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://rgs-enterprises.vercel.app
