# ==============================================================================
# RGS Enterprises - Godown Portfolio Management
# Environment Variables Configuration Template
# ==============================================================================

# Database Configuration (Supabase PostgreSQL or Local PostgreSQL)
# Format: jdbc:postgresql://<host>:<port>/<database>?sslmode=require
DATABASE_URL=jdbc:postgresql://db.xxxx.supabase.co:5432/postgres?sslmode=require
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here

# JWT Authentication
# Secret key: minimum 256 bits (32+ alphanumeric characters)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Initial Admin Bootstrap Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@RGS2026!

# Supabase Storage Integration (Documents Vault)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
STORAGE_BUCKET=godown-documents

# CORS Configuration (Set to frontend domain)
# For local dev: http://localhost:5173
# For production: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# Server Port
PORT=8080

